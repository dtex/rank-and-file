# Copy to .env and fill in. `npm start` reads .env; nothing here is needed for `npm test`.

# --- Where the app lives -------------------------------------------------
# The public address, without a trailing slash. OAuth callbacks, emailed links
# and Stripe return pages are built from it. Use https in production.
BASE_URL=http://localhost:3210
PORT=3210
# The app listens on this machine only; put a reverse proxy with HTTPS in front.
HOST=127.0.0.1
# Set to 1 when behind that proxy, so rate limits see the visitor's address.
TRUST_PROXY=
NODE_ENV=development

# Postgres on this machine.
DATABASE_URL=postgres://localhost/rank_and_file

# Signs cookies and unsubscribe links. Required in production. Keep it stable:
# changing it breaks unsubscribe links already sent. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Sign-in ---------------------------------------------------------------
# A provider is offered once both of its values are set.
# Callback URLs to register: <BASE_URL>/auth/google/callback and <BASE_URL>/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (sign-in links) -------------------------------------------------
# Google Workspace SMTP relay. Leave SMTP_USER and SMTP_PASS empty if the relay
# is set to accept this server's IP address; otherwise use an account and app password.
# Without SMTP_HOST in development, emails are printed in the terminal instead.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Rank and File <no-reply@example.com>

# --- Stripe ----------------------------------------------------------------
# Run `node scripts/stripe-setup.js` once to create the two prices.
# Webhook endpoint to register: <BASE_URL>/webhooks/stripe, with the events
# checkout.session.completed and customer.subscription.created/updated/deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# --- Who runs this, shown in the privacy policy and terms --------------------
OPERATOR_NAME=
CONTACT_EMAIL=
POSTAL_ADDRESS=
# Country (and region) of the server holding the database, for example "the United States (Texas)".
DATA_LOCATION=
# For example "the State of Texas, USA".
GOVERNING_LAW=

# Optional: how the app identifies itself to chess.com's API.
CHESSCOM_USER_AGENT=
