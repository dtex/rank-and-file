{
  "name": "rank-and-file",
  "version": "1.0.0",
  "description": "Rank and File: chess training for the rest of us. Opening missions tracked against your chess.com games.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "esbuild public/src/app.js --bundle --format=esm --minify --sourcemap --outfile=public/dist/app.js",
    "start": "npm run build && node start.js",
    "dev": "npm run build && node --watch start.js",
    "test": "node --test --test-concurrency=1",
    "migrate": "node scripts/migrate.js",
    "import-data": "node scripts/import-data.js",
    "claim": "node scripts/claim-account.js",
    "gift": "node scripts/gift.js",
    "marketing-list": "node scripts/marketing-list.js",
    "tree:check": "node scripts/build-tree.js",
    "openings": "node tools/openings/server.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "chess.js": "^1.4.0",
    "fastify": "^4.28.1",
    "lit": "^3.2.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "stripe": "^23.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
